rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participantIds;
    }

    function areMutualFriends(userId1, userId2) {
      // Allow if at least one side of the friendship link exists.
      // The app code repairs the missing side asynchronously.
      return exists(/databases/$(database)/documents/users/$(userId1)/friends/$(userId2)) ||
             exists(/databases/$(database)/documents/users/$(userId2)/friends/$(userId1));
    }

    function chatRoomParticipants(roomId) {
      return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow creation only for own profile
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow update/delete only for own profile
      allow update, delete: if request.auth != null && request.auth.uid == userId;

      // Subcollection: Friends
      // Doc ID is the friend's User ID.
      match /friends/{friendId} {
        // Allow read by any authenticated user (needed for mutual-friendship checks during chat)
        allow read: if request.auth != null;
        // Allow write if I am the user (e.g. removing friend) OR if I am the friend (adding myself as friend during request acceptance)
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // --- Friend Requests ---
    match /friend_requests/{requestId} {
      // Allow read if involved (sender or receiver)
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      // Allow create if sender is me
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      // Allow update if involved (e.g. cancelling or accepting/declining)
      allow update: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // --- Chat Rooms ---
    match /chat_rooms/{roomId} {
      // Allow read for any signed-in user.
      // The room ID is deterministic (sorted participant IDs), so a user
      // can only guess their own room IDs. Privacy of messages is further
      // protected by the /messages subcollection rules below.
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'participantIds',
          'lastMessage',
          'lastMessageTimestamp',
          'unreadCounts'
        ]) &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1] &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.lastMessageTimestamp is timestamp &&
        areMutualFriends(
          request.resource.data.participantIds[0],
          request.resource.data.participantIds[1]
        );

      allow update: if isChatParticipant(resource.data) &&
        request.resource.data.keys().hasOnly([
          'participantIds',
          'lastMessage',
          'lastMessageTimestamp',
          'unreadCounts'
        ]) &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.lastMessageTimestamp is timestamp;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
          request.auth.uid in chatRoomParticipants(roomId);

        allow create: if isSignedIn() &&
          exists(/databases/$(database)/documents/chat_rooms/$(roomId)) &&
          request.resource.data.keys().hasOnly([
            'chatId',
            'senderId',
            'receiverId',
            'text',
            'timestamp',
            'isRead'
          ]) &&
          request.auth.uid in chatRoomParticipants(roomId) &&
          request.resource.data.chatId == roomId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId in chatRoomParticipants(roomId) &&
          request.resource.data.receiverId in chatRoomParticipants(roomId) &&
          request.resource.data.senderId != request.resource.data.receiverId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.timestamp is timestamp &&
          request.resource.data.isRead == false;

        allow update: if false;
        // Allow delete by chat participants (for Clear Chat feature)
        allow delete: if isSignedIn() &&
          request.auth.uid in chatRoomParticipants(roomId);
      }
    }

    // --- Live Rooms ---
    match /rooms/{roomId} {
      // Public read needed for listing rooms
      allow read: if true;
      // Any auth user can create
      allow create: if request.auth != null;
      // Update is broad to allow listeners to join (update listeners array), 
      // add songs (update queue), and vote (update skipVotes).
      allow update: if request.auth != null;
      // Allow delete (Host or last listener cleanup)
      allow delete: if request.auth != null;

      match /events/{eventId} {
        allow read: if true;
        allow create: if request.auth != null;
      }
    }
  }
}